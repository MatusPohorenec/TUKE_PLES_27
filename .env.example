# Copy to .env for local development (npm run dev, db:migrate, db:seed); `npm run db:dev-setup` fills in
# the MSSQL_* lines for a local SQL Server. For the TUKE database keep a separate .env.tuke and pass it
# explicitly: npm run db:seed -- --env .env.tuke (the .env file is never used for it).
# On the IIS server these variables live in env.config next to the API (see README.md).

# Microsoft SQL Server, SQL Server authentication
MSSQL_SERVER=localhost
MSSQL_DATABASE=ples_dev
MSSQL_USER=ples_dev
MSSQL_PASSWORD=
# MSSQL_PORT=1433
# TLS is on by default. A local server has a self-signed certificate, so trust it there.
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# Passphrase for /admin. Required in production.
ADMIN_PASSWORD=change-me

# Optional. Random secret for signing the admin session cookie and hashing device / IP identifiers.
# Without it the server generates one and stores it in the app_settings table.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-secret-change-me

# Only when the web runs on another origin than the API (TUKE: https://srdcom.tuke.sk): the allowed web
# origins, comma separated. Unset = same origin (local development through the Vite proxy).
# WEB_ORIGIN=https://srdcom.tuke.sk
