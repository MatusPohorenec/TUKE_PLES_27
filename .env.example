# Copy to .env for local development. Without DATABASE_URL the API uses an embedded
# Postgres (PGlite) stored in .data/pglite.

# Postgres connection. Neon (Vercel Marketplace) sets this automatically on Vercel.
# DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# Passphrase for /admin. Required in production.
ADMIN_PASSWORD=change-me

# Optional. Random secret for signing the admin session cookie and hashing device / IP identifiers.
# Without it the server generates one and stores it in the app_settings table.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=dev-only-secret-change-me
