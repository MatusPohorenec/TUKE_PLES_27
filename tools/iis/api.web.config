<?xml version="1.0" encoding="utf-8"?>
<!--
  API site (api.srdcom.tuke.sk): IIS + iisnode on Plesk for Windows. Copied to deploy/api by tools/build-tuke.mjs.
  app.js is the startup file (Plesk: Node.js -> Application Startup File); every request is handed to it,
  and iisnode passes the original URL (/api/...) to Node.
  The settings (database, ADMIN_PASSWORD, WEB_ORIGIN …) live in env.config next to this file. It is not part of
  the build, so a deploy never overwrites it; iisnode turns its entries into environment variables.
  Without env.config IIS answers every request with error 500.19.
-->
<configuration>
  <appSettings configSource="env.config" />
  <system.webServer>
    <handlers>
      <!-- IIS would otherwise answer CORS preflights (OPTIONS) and DELETE itself -->
      <remove name="OPTIONSVerbHandler" />
      <remove name="WebDAV" />
      <add name="iisnode" path="app.js" verb="*" modules="iisnode" />
    </handlers>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <rewrite>
      <rules>
        <rule name="api" stopProcessing="true">
          <match url=".*" />
          <action type="Rewrite" url="app.js" />
        </rule>
      </rules>
    </rewrite>
    <!--
      enableXFF: the client address reaches Node as the last X-Forwarded-For entry (rate limits)
      devErrorsEnabled / debuggingEnabled off: no stack traces or debugger for visitors
      watchedFiles: a new bundle or new settings restart the Node process
      logs (stdout/stderr of Node) are written to the iisnode folder next to this file
    -->
    <iisnode enableXFF="true" devErrorsEnabled="false" debuggingEnabled="false" loggingEnabled="true"
             watchedFiles="web.config;env.config;app.js;api.mjs" />
    <!-- the JSON error bodies of the API pass through instead of IIS error pages -->
    <httpErrors existingResponse="PassThrough" />
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
