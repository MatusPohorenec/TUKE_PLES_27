<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings of the API on IIS. Save a copy as env.config in the root of api.srdcom.tuke.sk (next to web.config)
  and fill in the values. iisnode passes every entry to Node as an environment variable.
  Never commit env.config. Values must be plain ASCII (no diacritics) and XML-escaped: & as &amp;  < as &lt;  " as &quot;
  After a change the API restarts by itself (web.config watches this file).
-->
<appSettings>
  <add key="NODE_ENV" value="production" />

  <!-- Microsoft SQL Server (Plesk: Databases) -->
  <add key="MSSQL_SERVER" value="portal.msweb.tuke.sk" />
  <add key="MSSQL_DATABASE" value="" />
  <add key="MSSQL_USER" value="" />
  <add key="MSSQL_PASSWORD" value="" />
  <add key="MSSQL_ENCRYPT" value="true" />
  <add key="MSSQL_TRUST_SERVER_CERTIFICATE" value="true" />

  <!-- passphrase for /admin -->
  <add key="ADMIN_PASSWORD" value="" />
  <!-- optional: random secret of 32+ characters; without it the API keeps a generated one in table app_settings -->
  <add key="SESSION_SECRET" value="" />

  <!-- origin of the web app (CORS + admin cookie), several separated by commas -->
  <add key="WEB_ORIGIN" value="https://srdcom.tuke.sk" />
</appSettings>
