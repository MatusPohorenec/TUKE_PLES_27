# Settings of the API on the TUKE server (api.srdcom.tuke.sk). Save a copy as App_Data\.env in the root of
# the site (Plesk File Manager) and fill in the values. IIS never serves App_Data, a deploy never overwrites
# this file, and the API restarts by itself after a change. Never commit the filled-in file.
# Format: KEY=value per line, no quotes needed; a value with spaces or # goes in double quotes.

NODE_ENV=production

# Microsoft SQL Server (Plesk: Databases); the server has a self-signed certificate
MSSQL_SERVER=portal.msweb.tuke.sk
MSSQL_DATABASE=
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_ENCRYPT=true
MSSQL_TRUST_SERVER_CERTIFICATE=true

# passphrase for /admin
ADMIN_PASSWORD=
# optional: random secret of 32+ characters; without it the API keeps a generated one in table app_settings
SESSION_SECRET=

# origin of the web app (CORS + admin cookie), several separated by commas
WEB_ORIGIN=https://srdcom.tuke.sk
